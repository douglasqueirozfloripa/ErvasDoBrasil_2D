<Project>
  <!--
    Lint do C# fora da Unity: um projeto .NET por asmdef, compilando os MESMOS arquivos de Assets/
    com o Roslyn, os analisadores do .NET (CA*), as regras de estilo (IDE*) e o Microsoft.Unity.Analyzers (UNT*).
    Nada aqui é usado pela Unity; rode com ./scripts/lint.sh.
  -->
  <PropertyGroup>
    <ProjectRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</ProjectRoot>
    <!-- o script passa -p:UnityScripting=...; o padrão é a versão de ProjectSettings/ProjectVersion.txt no Unity Hub -->
    <UnityScripting Condition="'$(UnityScripting)' == ''">/Applications/Unity/Hub/Editor/6000.3.26f1/Unity.app/Contents/Resources/Scripting</UnityScripting>
    <UnityManaged>$(UnityScripting)/Managed/UnityEngine</UnityManaged>

    <!-- igual à Unity 6: .NET Standard 2.1 e C# 9 (o lint não sugere recursos que a Unity não compila) -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- análise estática -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- necessário para a regra IDE0005 (using desnecessário) rodar no build; CS1591 (falta de comentário XML) fica de fora -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <!-- saída fora do código: Builds/lint (ignorado pelo git) -->
    <ArtifactsPath>$(ProjectRoot)Builds/lint</ArtifactsPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.28.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
