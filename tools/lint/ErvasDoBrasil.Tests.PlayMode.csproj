<Project Sdk="Microsoft.NET.Sdk">
  <!-- Espelha Assets/Tests/PlayMode/ErvasDoBrasil.Tests.PlayMode.asmdef: testes de interface sobre o jogo inteiro -->
  <PropertyGroup>
    <AssemblyName>ErvasDoBrasil.Tests.PlayMode</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProjectRoot)Assets/Tests/PlayMode/**/*.cs" />
    <ProjectReference Include="ErvasDoBrasil.Core.csproj" />
    <ProjectReference Include="ErvasDoBrasil.Game.csproj" />
    <Reference Include="$(UnityManaged)/UnityEngine.*.dll" Private="false" />
    <Reference Include="$(ProjectRoot)Library/PackageCache/com.unity.ext.nunit*/net40/unity-custom/nunit.framework.dll" Private="false" />
    <!-- [UnityTest] e [UnitySetUp] vêm do com.unity.test-framework, que a Unity compila em Library/ScriptAssemblies -->
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/UnityEngine.TestRunner.dll" Private="false" />
  </ItemGroup>
</Project>
